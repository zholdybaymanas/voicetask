# Supabase — https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Public URL of the deployed app (used as `emailRedirectTo` for signup/reset).
# In production set to your Vercel domain. Locally можно оставить пустым —
# тогда useAuth подставит window.location.origin (http://localhost:5173).
VITE_APP_URL=https://voicetask-cfo.vercel.app

# Supabase service role (только для api/admin.js — НИКОГДА не в frontend!)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic — для api/tasks.js (голосовой парсинг через Claude Haiku)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
